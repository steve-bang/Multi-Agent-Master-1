{
  "_comment": "Project-specific configuration. Placeholders (null) are intentional: the repository has no application stack yet. The first feature's technical plan must fill these in; run-checks treats a required check with no command as NOT passing.",
  "default_branch": "main",
  "branch_prefix": "ai/",
  "auto_merge": false,
  "auto_deploy": false,
  "notification": {
    "channel": "in-session",
    "external_integration": null
  },
  "review": {
    "max_cycles": 4,
    "escalate_after_cycles": 3
  },
  "bugfix": {
    "max_cycles": 4
  },
  "checks": {
    "build": {
      "command": "npm run build",
      "required": true
    },
    "lint": {
      "command": "npm run lint",
      "required": true
    },
    "typecheck": {
      "command": "npx tsc --noEmit",
      "required": false
    },
    "unit": {
      "command": "npm test",
      "required": true
    },
    "integration": {
      "command": "npx vitest run test/integration",
      "required": false
    },
    "static_analysis": {
      "command": "npm audit --omit=dev --audit-level=high",
      "required": false
    }
  }
}
